rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // attendance collection
    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // exitPermissions collection
    match /exitPermissions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // izinKeluar collection (alias)
    match /izinKeluar/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // leaveRequests collection
    match /leaveRequests/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // cuti collection (alias)
    match /cuti/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // warningLetters collection
    match /warningLetters/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // slipUbar collection
    match /slipUbar/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // schedules collection
    match /schedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // manhajiyyahClauses collection
    match /manhajiyyahClauses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /fcmTokens/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
