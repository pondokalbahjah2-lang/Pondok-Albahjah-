rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // attendance collection
    match /attendance/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // exitPermissions collection
    match /exitPermissions/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // izinKeluar collection (alias)
    match /izinKeluar/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // leaveRequests collection
    match /leaveRequests/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // cuti collection (alias)
    match /cuti/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // warningLetters collection
    match /warningLetters/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // slipUbar collection
    match /slipUbar/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // schedules collection
    match /schedules/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // manhajiyyahClauses collection
    match /manhajiyyahClauses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // divisi collection
    match /divisi/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // liburPengurus collection
    match /liburPengurus/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }


    // kajian collection
    match /kajian/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }
    match /fcmTokens/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // TEACHING (MENGAJAR & JP) COLLECTIONS
    // ==========================================

    match /teachingLocations/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teachingClasses/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teachingSchedules/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /settings/teaching {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /teachingAttendance/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.pejuangId == request.auth.uid || resource.data.scheduledPejuangId == request.auth.uid));
      allow create: if isSignedIn() &&
        request.resource.data.pejuangId == request.auth.uid &&
        docId == (request.resource.data.scheduleId + '_' + request.resource.data.date) &&
        request.resource.data.source == 'GPS';
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.pejuangId == request.auth.uid &&
        request.resource.data.jamMasuk == resource.data.jamMasuk &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.pejuangId == resource.data.pejuangId &&
        request.resource.data.scheduleId == resource.data.scheduleId
      );
      allow delete: if isAdmin();
    }

    match /teachingSubstitutions/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.originalPejuangId == request.auth.uid || resource.data.substitutePejuangId == request.auth.uid));
      allow create: if isSignedIn() &&
        request.resource.data.originalPejuangId == request.auth.uid &&
        request.resource.data.status == 'Menunggu Persetujuan';
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.originalPejuangId == request.auth.uid &&
        request.resource.data.status == 'Dibatalkan'
      );
      allow delete: if isAdmin();
    }
  }
}
