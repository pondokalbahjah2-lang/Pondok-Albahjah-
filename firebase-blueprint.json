{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User profile and credentials",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "password": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "subDivisi": { "type": "string" },
        "amanah": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["username", "name", "role", "subDivisi", "amanah"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance logs",
      "type": "object",
      "properties": {
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "subDivisi": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "photoUrl": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "distanceFromPondok": { "type": "number" },
        "status": { "type": "string" },
        "isWithinRadius": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "required": ["pejuangId", "pejuangName", "subDivisi", "date", "time", "status"]
    },
    "ExitPermissionRecord": {
      "title": "ExitPermissionRecord",
      "description": "Exit permissions",
      "type": "object",
      "properties": {
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "subDivisi": { "type": "string" },
        "alasan": { "type": "string" },
        "tanggalKeluar": { "type": "string" },
        "tanggalIzinSampai": { "type": "string" },
        "tanggalKembaliReal": { "type": "string" },
        "jamKeluar": { "type": "string" },
        "jamHarusKembali": { "type": "string" },
        "jamKembaliReal": { "type": "string" },
        "status": { "type": "string" },
        "keteranganKeterlambatan": { "type": "string" }
      },
      "required": ["pejuangId", "tanggalKeluar", "status"]
    },
    "LeaveRequestRecord": {
      "title": "LeaveRequestRecord",
      "description": "Leave requests",
      "type": "object",
      "properties": {
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "subDivisi": { "type": "string" },
        "alasan": { "type": "string" },
        "tanggalMulai": { "type": "string" },
        "tanggalSelesai": { "type": "string" },
        "totalHari": { "type": "number" },
        "status": { "type": "string" },
        "tanggalPengajuan": { "type": "string" },
        "catatanAdmin": { "type": "string" }
      },
      "required": ["pejuangId", "tanggalMulai", "status"]
    },
    "WarningLetterRecord": {
      "title": "WarningLetterRecord",
      "description": "Warning letters",
      "type": "object",
      "properties": {
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "subDivisi": { "type": "string" },
        "type": { "type": "string" },
        "tanggal": { "type": "string" },
        "alasan": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" }
      },
      "required": ["pejuangId", "type", "tanggal"]
    },
    "SlipUbarRecord": {
      "title": "SlipUbarRecord",
      "description": "Salary slips",
      "type": "object",
      "properties": {
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "periode": { "type": "string" },
        "tanggalUpload": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" }
      },
      "required": ["pejuangId", "periode", "fileUrl"]
    },
    "TeachingLocation": {
      "title": "TeachingLocation",
      "description": "Teaching GPS geofence locations",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radiusMeters": { "type": "number" },
        "maxAccuracyMeters": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "latitude", "longitude", "radiusMeters", "isActive"]
    },
    "TeachingClass": {
      "title": "TeachingClass",
      "description": "Teaching classes per educational unit",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "level": { "type": "string" },
        "notes": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["name", "unit", "isActive"]
    },
    "TeachingSchedule": {
      "title": "TeachingSchedule",
      "description": "Teaching class schedules",
      "type": "object",
      "properties": {
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "unit": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "jumlahJP": { "type": "number" },
        "hari": { "type": "array", "items": { "type": "string" } },
        "jamMulai": { "type": "string" },
        "jamSelesai": { "type": "string" },
        "locationId": { "type": "string" },
        "locationName": { "type": "string" },
        "berlakuMulai": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["pejuangId", "subject", "jumlahJP", "hari", "jamMulai", "jamSelesai", "isActive"]
    },
    "TeachingAttendance": {
      "title": "TeachingAttendance",
      "description": "Teaching attendance records",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string" },
        "date": { "type": "string" },
        "pejuangId": { "type": "string" },
        "pejuangName": { "type": "string" },
        "scheduledPejuangId": { "type": "string" },
        "scheduledPejuangName": { "type": "string" },
        "isBadal": { "type": "boolean" },
        "unit": { "type": "string" },
        "className": { "type": "string" },
        "subject": { "type": "string" },
        "jumlahJP": { "type": "number" },
        "jamMasuk": { "type": "string" },
        "jamPulang": { "type": "string" },
        "status": { "type": "string" },
        "lateMinutes": { "type": "number" },
        "source": { "type": "string" }
      },
      "required": ["scheduleId", "date", "pejuangId", "status", "source"]
    },
    "TeachingSubstitution": {
      "title": "TeachingSubstitution",
      "description": "Teaching badal substitutions",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string" },
        "date": { "type": "string" },
        "originalPejuangId": { "type": "string" },
        "originalPejuangName": { "type": "string" },
        "substitutePejuangId": { "type": "string" },
        "substitutePejuangName": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["scheduleId", "date", "originalPejuangId", "substitutePejuangId", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserAccount",
      "description": "User profiles"
    },
    "attendance/{docId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records"
    },
    "exitPermissions/{docId}": {
      "schema": "ExitPermissionRecord",
      "description": "Exit permissions"
    },
    "leaveRequests/{docId}": {
      "schema": "LeaveRequestRecord",
      "description": "Leave requests"
    },
    "warningLetters/{docId}": {
      "schema": "WarningLetterRecord",
      "description": "Warning letters"
    },
    "slipUbar/{docId}": {
      "schema": "SlipUbarRecord",
      "description": "Salary slips"
    },
    "teachingLocations/{docId}": {
      "schema": "TeachingLocation",
      "description": "Teaching GPS locations"
    },
    "teachingClasses/{docId}": {
      "schema": "TeachingClass",
      "description": "Teaching classes"
    },
    "teachingSchedules/{docId}": {
      "schema": "TeachingSchedule",
      "description": "Teaching class schedules"
    },
    "teachingAttendance/{docId}": {
      "schema": "TeachingAttendance",
      "description": "Teaching attendance records"
    },
    "teachingSubstitutions/{docId}": {
      "schema": "TeachingSubstitution",
      "description": "Teaching substitutions"
    }
  }
}
